# Copy to .env.local for local development. Both values are safe to expose in the browser
# (Row Level Security protects the data). Never put a service-role key or GitHub token here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Google OAuth 2.0 Web client ID from Google Cloud > Google Auth Platform > Clients.
# Add your site's origins (e.g. https://mauamarketplace.eu.cc and http://localhost:5173)
# to Authorized JavaScript origins. This popup flow does not use a Supabase redirect URI.
VITE_GOOGLE_CLIENT_ID=YOUR-GOOGLE-WEB-CLIENT-ID.apps.googleusercontent.com
